import React, { useState, useEffect } from 'react';

export default function App() {
  // 游戏状态模拟
  const [isDead, setIsDead] = useState(false);
  const [countdown, setCountdown] = useState(10); // 默认复活倒计时10秒
  const [isConfirmingBuy, setIsConfirmingBuy] = useState(false);
  const [coins, setCoins] = useState(300); // 初始金币，设置为300以测试金币不足的情况
  
  const reviveCost = 500; // 立刻复活所需金钱

  // 倒计时逻辑
  useEffect(() => {
    let timer;
    if (isDead && countdown > 0) {
      timer = setInterval(() => {
        setCountdown((prev) => prev - 1);
      }, 1000);
    }
    return () => clearInterval(timer);
  }, [isDead, countdown]);

  // 重置状态
  const triggerDeath = () => {
    setIsDead(true);
    setCountdown(10);
    setIsConfirmingBuy(false);
  };

  // 触发复活
  const revive = () => {
    setIsDead(false);
    setIsConfirmingBuy(false);
  };

  // 左侧按钮：普通复活（左键点击）
  const handleNormalReviveClick = () => {
    if (countdown === 0) {
      revive();
    }
  };

  // 右侧按钮：购买复活（右键交互）
  const handleBuyReviveContextMenu = (e) => {
    e.preventDefault(); // 阻止浏览器默认右键菜单
    if (coins < reviveCost) return; // 金币不足时无法触发
    // 切换确认状态（右键触发确认，再次右键取消）
    setIsConfirmingBuy((prev) => !prev);
  };

  // 右侧按钮：左键点击确认
  const handleBuyReviveClick = (e) => {
    if (isConfirmingBuy && coins >= reviveCost) {
      setCoins((prev) => prev - reviveCost); // 扣除金币
      console.log(`花费 ${reviveCost} 金币立刻复活！`);
      revive();
    }
  };

  return (
    <div className="relative w-full h-screen bg-gray-800 text-white font-sans overflow-hidden select-none flex items-center justify-center">
      {/* 模拟游戏背景，颜色近似截图的灰色空缺区域 */}
      <div className="absolute inset-0 bg-[#4a4a4d]"></div>

      {/* 测试用：控制角色死亡的按钮 */}
      <div className="absolute top-4 left-4 z-50 flex flex-col space-y-3">
        {/* 显示当前金币并提供增加金币的按钮 */}
        <div className="flex items-center space-x-3 bg-gray-900/80 p-2 rounded border border-gray-600 shadow-md">
          <span className="text-yellow-400 font-mono font-bold">金币: {coins}</span>
          <button 
            onClick={() => setCoins(c => c + 200)}
            className="px-2 py-1 bg-yellow-600 hover:bg-yellow-500 text-xs text-white rounded transition-colors"
          >
            +200
          </button>
        </div>

        {!isDead && (
          <button
            onClick={triggerDeath}
            className="px-4 py-2 bg-red-600 hover:bg-red-500 text-white font-bold border-2 border-red-800 rounded shadow-[0_0_10px_rgba(220,38,38,0.5)] transition-all"
          >
            [测试] 模拟角色死亡
          </button>
        )}
        {isDead && (
          <div className="px-4 py-2 bg-black/50 text-green-400 font-mono border border-green-500 rounded">
            玩家已死亡，等待复活...
          </div>
        )}
      </div>

      {/* 复活面板 - 死亡后出现，复活后消失 */}
      {isDead && (
        <div className="absolute bottom-[15%] left-1/2 -translate-x-1/2 flex flex-col items-center z-40 bg-gray-900/90 backdrop-blur-md border border-gray-700/80 p-8 rounded-2xl shadow-[0_0_40px_rgba(0,0,0,0.8)]">
          
          {/* 倒计时提示 */}
          <div className="mb-6 flex flex-col items-center">
            <span className="text-red-500 font-bold text-base tracking-widest drop-shadow-[0_0_8px_rgba(239,68,68,0.8)] mb-1">
              SYSTEM REBOOT IN
            </span>
            <span className="text-4xl font-black text-white tracking-tighter drop-shadow-[0_0_10px_rgba(255,255,255,0.5)]">
              {countdown > 0 ? `00:${countdown.toString().padStart(2, '0')}` : 'READY'}
            </span>
          </div>

          {/* 按钮容器 */}
          <div className="flex space-x-6">
            
            {/* 左侧按钮：普通复活 */}
            <button
              onClick={handleNormalReviveClick}
              disabled={countdown > 0}
              className={`relative flex flex-col items-center justify-center w-48 py-4 rounded-xl border-2 transition-all duration-300 ${
                countdown === 0
                  ? 'bg-cyan-900/60 border-cyan-400 hover:bg-cyan-600/60 hover:shadow-[0_0_20px_rgba(34,211,238,0.6)] cursor-pointer text-cyan-300'
                  : 'bg-gray-800 border-gray-600 opacity-80 cursor-not-allowed text-gray-500'
              }`}
            >
              <span className="text-xl font-bold mb-1">普通复活</span>
              <span className="text-sm font-medium">
                {countdown > 0 ? `冷却中 (${countdown}s)` : '点击左键复活'}
              </span>
            </button>

            {/* 右侧按钮：立刻复活 */}
            <button
              onClick={handleBuyReviveClick}
              onContextMenu={handleBuyReviveContextMenu}
              className={`relative flex flex-col items-center justify-center w-56 py-4 rounded-xl border-2 transition-all duration-300 ${
                coins < reviveCost
                  ? 'bg-gray-800/90 border-red-900/50 cursor-not-allowed opacity-80'
                  : isConfirmingBuy
                    ? 'bg-green-900/80 border-green-400 shadow-[0_0_25px_rgba(74,222,128,0.7)] text-green-300 ring-2 ring-green-400/50 cursor-pointer'
                    : 'bg-amber-900/60 border-amber-500 hover:bg-amber-700/60 hover:shadow-[0_0_20px_rgba(245,158,11,0.6)] text-amber-400 cursor-pointer'
              }`}
            >
              {!isConfirmingBuy ? (
                <>
                  <span className={`text-xl font-bold mb-1 ${coins < reviveCost ? 'text-red-400' : ''}`}>
                    {coins < reviveCost ? '金币不足' : '立刻复活'}
                  </span>
                  <div className="flex items-center space-x-2 text-sm mt-1">
                    <span className={`font-bold px-2 py-0.5 rounded border ${
                      coins < reviveCost 
                        ? 'bg-red-950/80 text-red-300 border-red-800/50' 
                        : 'bg-amber-950/80 text-amber-200 border-amber-700/50'
                    }`}>
                      $ {reviveCost}
                    </span>
                    <span className={`${coins < reviveCost ? 'text-red-300/50 border-red-800/50' : 'text-amber-100/70 border-amber-700/50'} border-l pl-2`}>
                      右键触发
                    </span>
                  </div>
                </>
              ) : (
                <>
                  <span className="text-xl font-bold mb-1 text-green-400">确认购买？</span>
                  <div className="flex items-center space-x-2 text-xs font-bold mt-1">
                    <span className="bg-green-950/80 text-green-200 px-2 py-1 rounded border border-green-700/50">左键 确认</span>
                    <span className="bg-red-950/80 text-red-300 px-2 py-1 rounded border border-red-800/50">右键 取消</span>
                  </div>
                </>
              )}
            </button>

          </div>
        </div>
      )}
    </div>
  );
}